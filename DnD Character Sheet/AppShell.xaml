<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DnD_Character_Sheet.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DnD_Character_Sheet"
    Shell.FlyoutBehavior="Disabled"
    Title="DnD_Character_Sheet">

    <ShellContent
        Title="Character Sheet"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <Shell.ToolbarItems>
        <ToolbarItem Text="New" Clicked="OnNewClicked" />
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
        <ToolbarItem Text="Load" Clicked="OnLoadClicked" />
    </Shell.ToolbarItems>
</Shell>
